# OpenAI API key for the conversational agent
OPENAI_API_KEY=

# Used ONLY for Alembic migrations (`alembic upgrade head`) and the one-off
# seed scripts (`python -m app.db.seed`, `python -m app.db.seed_templates`).
# This is a rare, occasional operation — run it from any network that can
# reach Supabase directly (a hotspot works fine if your regular network
# blocks direct Postgres ports 5432/6543, which some corporate networks do).
# Use the "Session pooler" connection string from Supabase's Connect dialog,
# not "Direct connection" — the direct one is IPv6-only unless you pay for
# the IPv4 add-on, and most networks (including many corporate ones) don't
# route IPv6. Append ?sslmode=require.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/delivery_agent

# Used by the RUNNING APP for every chat/upload/download request, via
# Supabase's REST API (app/db/rest_client.py) instead of a direct database
# connection — plain HTTPS, so it works even on networks that block direct
# database ports entirely (confirmed: this was necessary, not optional, on
# at least one corporate network this project runs on).
#
# SUPABASE_URL: Project Settings -> API -> Project URL
# SUPABASE_KEY: Project Settings -> API -> service_role secret key
#   (NOT the anon/public key — service_role bypasses Row Level Security,
#   which is correct here since this backend is the only trusted access
#   point; the frontend never talks to Supabase directly. Never expose this
#   key to a browser/frontend.)
SUPABASE_URL=
SUPABASE_KEY=

# Local storage roots (POC only — swapped for SharePoint/Blob storage later)
TEMPLATE_STORE_PATH=../templates
CLIENT_STORE_PATH=../clients

# Path to the canonical phase config (source of truth for gating logic)
PHASE_CONFIG_PATH=../config/sdlc_phase_config.json
