# Production environment template for the RAG agent backend.
#
# DO NOT put real secrets in this file. It exists so operators know which
# variables the app expects; the actual values live in the Azure DevOps
# variable group `rag-agent-prd` and are injected at deploy time.
#
# Anything committed here should be assumed public.

# Set to your managed Postgres (pgvector-enabled) connection string.
DATABASE_URL=postgresql+psycopg://user:password@host:5432/rag_agent

# Set in ADO variable group `rag-agent-prd`, NOT here.
OPENAI_API_KEY=set-in-ado-variable-group

# Set in ADO variable group `rag-agent-prd`, NOT here.
SUPABASE_URL=
SUPABASE_KEY=

LOG_LEVEL=INFO
ENVIRONMENT=prd
