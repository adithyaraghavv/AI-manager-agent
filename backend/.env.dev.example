# Only used by the one-off Alembic migrations/seed scripts (the running app
# talks to Supabase over its REST API, not this). There's no local Postgres
# container in docker-compose.yml anymore — point this at a real reachable
# Postgres (e.g. Supabase's direct connection string) if you ever need to
# run those scripts locally.
DATABASE_URL=
OPENAI_API_KEY=sk-replace-me
SUPABASE_URL=
SUPABASE_KEY=
LOG_LEVEL=DEBUG
ENVIRONMENT=dev

# Browser CORS: comma-separated origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Comma-separated origins allowed to embed this app in an iframe (e.g. a
# SharePoint page). Leave blank locally; set to the SharePoint site origin
# once deployed, e.g. https://marlabsinc.sharepoint.com
IFRAME_ALLOWED_ORIGINS=
