# PM Document Assistant — Environment Variables
# Copy this to .env and fill in your values

# OpenAI API Key (optional — enables GPT-4o intent detection)
# Without this, rule-based fallback is used (still fully functional)
OPENAI_API_KEY=sk-your-openai-key-here

# Server config
PORT=8000
HOST=0.0.0.0

# Storage paths (defaults to ../Templates and ../Clients relative to backend/)
# TEMPLATES_DIR=/absolute/path/to/Templates
# CLIENTS_DIR=/absolute/path/to/Clients
